# --- Database (Postgres on "someting hosting"). Leave empty to use local JSON files in ./data
DATABASE_URL=

# --- OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FURNITIQ_CHAT_MODEL=anthropic/claude-sonnet-5.5
FURNITIQ_IMAGE_MODEL=google/gemini-2.5-flash-image

# --- Allio agents (optional second AI provider)
ALLIO_URL=
ALLIO_TOKEN=
ALLIO_GROUP=
ALLIO_DEFAULT_AGENT=

# --- Where local files (renders, fallback JSON projects) are stored. On someting hosting: /data (persistent)
FURNITIQ_DATA_DIR=

# --- Local Claude Code CLI as chat provider (no API key; uses your `claude` login). Local dev only.
# FURNITIQ_CLAUDE_CLI=0 disables it; FURNITIQ_CLAUDE_BIN / FURNITIQ_CLAUDE_MODEL override binary and model.
FURNITIQ_CLAUDE_BIN=
FURNITIQ_CLAUDE_MODEL=
